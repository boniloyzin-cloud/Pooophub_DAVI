    end
end)

SubmitBtn.MouseButton1Click:Connect(function()
    local enteredKey = string.gsub(KeyInput.Text, "%s+", "")
    if VALID_KEYS[enteredKey] then
        StatusLabel.Text = "Key Correct!"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 180)
        task.wait(0.5)

        -- Transition from Key Window to Loading Screen
        MainFrame.Visible = false
        LoadingFrame.Visible = true

        -- Smooth 1% to 100% Progress Animation
        for i = 1, 100 do
            ProgressBarFill.Size = UDim2.new(i / 100, 0, 1, 0)
            PercentageLabel.Text = tostring(i) .. "%"
            task.wait(0.02) -- Adjust speed if needed
        end

        task.wait(0.3)
        ScreenGui:Destroy()

        -- Execute the script
        loadstring(game:HttpGet("https://raw.githubusercontent.com/boniloyzin-cloud/DAVI_FTAPPOOPHUB/refs/heads/main/DAVI_FTAP"))()
    else
        StatusLabel.Text = "Invalid Key! Try again."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end)
